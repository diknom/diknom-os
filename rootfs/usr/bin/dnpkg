#!/bin/bash
# ============================================
#   dnpkg - DIKNOM Package Manager v1.1
#   Support: apt (Debian) & apk (Alpine)
# ============================================

RED='\033[0;31m'; GREEN='\033[0;32m'
BLUE='\033[0;34m'; YELLOW='\033[1;33m'
CYAN='\033[0;36m'; BOLD='\033[1m'; NC='\033[0m'

VERSION="1.1"
LOG="/var/log/dnpkg-history.log"
CMD="$1"
PKG="$2"

# Deteksi package manager otomatis
if command -v apt-get &>/dev/null; then
    PM="apt"
elif command -v apk &>/dev/null; then
    PM="apk"
else
    PM="unknown"
fi

header() {
    echo ""
    echo -e "${BLUE}╔══════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}  ${BOLD}dnpkg${NC} - DIKNOM Package Manager v${VERSION}  ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════╝${NC}"
    echo ""
}

log_act() {
    mkdir -p /var/log
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG" 2>/dev/null || true
}

cek_root() {
    [ "$(id -u)" != "0" ] && exec sudo "$0" "$@"
}

# ===== INSTALL =====
cmd_install() {
    [ -z "$PKG" ] && {
        echo -e "${RED}[✗]${NC} Masukkan nama paket. Contoh: dnpkg install firefox"
        exit 1
    }
    header
    echo -e "${CYAN}[→]${NC} Mencari paket: ${BOLD}$PKG${NC}..."
    echo ""
    cek_root
    if [ "$PM" = "apt" ]; then
        apt-get install -y "$PKG"
    else
        apk add "$PKG"
    fi
    echo ""
    echo -e "${GREEN}[✓]${NC} ${BOLD}$PKG${NC} berhasil diinstall!"
    log_act "INSTALL: $PKG"
}

# ===== REMOVE =====
cmd_remove() {
    [ -z "$PKG" ] && {
        echo -e "${RED}[✗]${NC} Masukkan nama paket. Contoh: dnpkg remove firefox"
        exit 1
    }
    header
    echo -e "${YELLOW}[→]${NC} Menghapus: ${BOLD}$PKG${NC}..."
    echo ""
    cek_root
    if [ "$PM" = "apt" ]; then
        apt-get remove -y "$PKG"
    else
        apk del "$PKG"
    fi
    echo ""
    echo -e "${GREEN}[✓]${NC} ${BOLD}$PKG${NC} berhasil dihapus!"
    log_act "REMOVE: $PKG"
}

# ===== UPDATE =====
cmd_update() {
    header
    echo -e "${CYAN}[→]${NC} Memperbarui semua paket sistem..."
    echo ""
    cek_root
    if [ "$PM" = "apt" ]; then
        apt-get update && apt-get upgrade -y
    else
        apk update && apk upgrade
    fi
    echo ""
    echo -e "${GREEN}[✓]${NC} Sistem berhasil diperbarui!"
    log_act "UPDATE: sistem diperbarui"
}

# ===== SEARCH =====
cmd_search() {
    [ -z "$PKG" ] && {
        echo -e "${RED}[✗]${NC} Masukkan kata kunci. Contoh: dnpkg search browser"
        exit 1
    }
    header
    echo -e "${CYAN}[→]${NC} Mencari: ${BOLD}$PKG${NC}"
    echo ""
    if [ "$PM" = "apt" ]; then
        apt-cache search "$PKG"
    else
        apk search "$PKG"
    fi
}

# ===== INFO =====
cmd_info() {
    [ -z "$PKG" ] && { echo -e "${RED}[✗]${NC} Masukkan nama paket."; exit 1; }
    header
    if [ "$PM" = "apt" ]; then
        apt-cache show "$PKG"
    else
        apk info -a "$PKG"
    fi
}

# ===== LIST =====
cmd_list() {
    header
    echo -e "${CYAN}[→]${NC} Paket yang terinstall:"
    echo ""
    if [ "$PM" = "apt" ]; then
        dpkg --get-selections | grep -v deinstall | awk '{print $1}' | sort
    else
        apk list --installed | sort
    fi
}

# ===== AUTOREMOVE =====
cmd_autoremove() {
    header
    cek_root
    echo -e "${YELLOW}[→]${NC} Menghapus paket tidak terpakai..."
    echo ""
    if [ "$PM" = "apt" ]; then
        apt-get autoremove -y
    else
        apk autoremove
    fi
    echo -e "${GREEN}[✓]${NC} Selesai!"
    log_act "AUTOREMOVE"
}

# ===== CLEAN =====
cmd_clean() {
    header
    cek_root
    echo -e "${YELLOW}[→]${NC} Membersihkan cache..."
    echo ""
    if [ "$PM" = "apt" ]; then
        apt-get clean
        rm -rf /var/lib/apt/lists/*
    else
        apk cache clean
    fi
    echo -e "${GREEN}[✓]${NC} Cache bersih!"
    log_act "CLEAN"
}

# ===== HISTORY =====
cmd_history() {
    header
    echo -e "${CYAN}[→]${NC} Riwayat penggunaan dnpkg:"
    echo ""
    [ -f "$LOG" ] && tail -30 "$LOG" || echo "  Belum ada riwayat."
}

# ===== DOCTOR =====
cmd_doctor() {
    header
    echo -e "${CYAN}[→]${NC} Memeriksa kesehatan sistem..."
    echo ""
    ping -c 1 google.com &>/dev/null 2>&1 \
        && echo -e "  ${GREEN}[✓]${NC} Internet: OK" \
        || echo -e "  ${RED}[✗]${NC} Internet: TIDAK ADA"
    echo -e "  ${GREEN}[✓]${NC} Disk: $(df -h / | awk 'NR==2{print $4}') tersisa"
    echo -e "  ${GREEN}[✓]${NC} RAM: $(free -h | awk '/Mem/{print $4}') tersisa"
    echo -e "  ${GREEN}[✓]${NC} Package manager: $PM"
    echo ""
    echo -e "${GREEN}[✓]${NC} Pemeriksaan selesai!"
}

# ===== BACKUP =====
cmd_backup() {
    header
    FILE="$HOME/dnpkg-backup-$(date '+%Y%m%d').txt"
    if [ "$PM" = "apt" ]; then
        dpkg --get-selections > "$FILE"
    else
        apk list --installed > "$FILE"
    fi
    echo -e "${GREEN}[✓]${NC} Backup disimpan: $FILE"
}

# ===== STORE =====
cmd_store() {
    header
    echo -e "${BOLD}  DIKNOM APP STORE 🛍️${NC}"
    echo ""
    echo "  [1] Browser     - Firefox, Chromium"
    echo "  [2] Office      - LibreOffice"
    echo "  [3] Media       - VLC, MPV"
    echo "  [4] Dev Tools   - Geany, VSCode"
    echo "  [5] Grafis      - GIMP, Inkscape"
    echo "  [0] Keluar"
    echo ""
    read -p "  Pilih: " P
    case "$P" in
        1) dnpkg search browser ;;
        2) dnpkg search libreoffice ;;
        3) dnpkg search vlc ;;
        4) dnpkg search geany ;;
        5) dnpkg search gimp ;;
        0) exit 0 ;;
    esac
}

# ===== HELP =====
cmd_help() {
    echo ""
    echo -e "${BLUE}╔══════════════════════════════════════════════╗${NC}"
    echo -e "${BLUE}║${NC}    ${BOLD}dnpkg${NC} — DIKNOM Package Manager v${VERSION}       ${BLUE}║${NC}"
    echo -e "${BLUE}║${NC}        DIKNOM OS 1.0 - Blitar Edition        ${BLUE}║${NC}"
    echo -e "${BLUE}╚══════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "${BOLD}  PENGGUNAAN:${NC}"
    echo "    dnpkg [perintah] [nama-paket]"
    echo ""
    echo -e "${BOLD}  PERINTAH:${NC}"
    echo -e "    ${GREEN}install${NC}    <paket>   Install paket baru"
    echo -e "    ${RED}remove${NC}     <paket>   Hapus paket"
    echo -e "    ${CYAN}update${NC}               Update semua paket"
    echo -e "    ${CYAN}search${NC}     <paket>   Cari paket"
    echo -e "    ${CYAN}info${NC}       <paket>   Info detail paket"
    echo -e "    ${CYAN}list${NC}                 Daftar paket terinstall"
    echo -e "    ${YELLOW}autoremove${NC}           Hapus paket tidak terpakai"
    echo -e "    ${YELLOW}clean${NC}                Bersihkan cache"
    echo -e "    ${CYAN}history${NC}              Riwayat install/remove"
    echo -e "    ${CYAN}backup${NC}               Backup daftar paket"
    echo -e "    ${CYAN}doctor${NC}               Cek kesehatan sistem"
    echo -e "    ${CYAN}store${NC}                Toko aplikasi"
    echo -e "    ${CYAN}help${NC}                 Bantuan ini"
    echo ""
    echo -e "${BOLD}  CONTOH:${NC}"
    echo "    dnpkg install firefox"
    echo "    dnpkg remove vlc"
    echo "    dnpkg update"
    echo ""
    echo -e "  Engine: ${CYAN}$PM${NC} | Versi: ${CYAN}dnpkg $VERSION${NC}"
    echo ""
}

# ===== ROUTER =====
case "$CMD" in
    install)           cmd_install ;;
    remove|delete)     cmd_remove ;;
    update|upgrade)    cmd_update ;;
    search|find)       cmd_search ;;
    info|show)         cmd_info ;;
    list|ls)           cmd_list ;;
    autoremove)        cmd_autoremove ;;
    clean|clear)       cmd_clean ;;
    history|log)       cmd_history ;;
    doctor|check)      cmd_doctor ;;
    backup)            cmd_backup ;;
    store|app)         cmd_store ;;
    help|--help|-h)    cmd_help ;;
    "")                cmd_help ;;
    *)
        echo -e "\n  ${RED}[✗]${NC} Perintah '$CMD' tidak dikenal."
        echo "       Ketik 'dnpkg help' untuk bantuan.\n"
        exit 1 ;;
esac
