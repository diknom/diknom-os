#!/bin/bash
# ============================================
#   dn-update - Update Sistem DIKNOM OS
# ============================================

GREEN='\033[0;32m'
CYAN='\033[0;36m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

echo ""
echo -e "${CYAN}╔══════════════════════════════════════╗${NC}"
echo -e "${CYAN}║${NC}   ${BOLD}dn-update${NC} — Update Sistem DIKNOM OS  ${CYAN}║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════╝${NC}"
echo ""

# Cek root
if [ "$(id -u)" != "0" ]; then
    exec sudo "$0" "$@"
fi

echo -e "${CYAN}[1/3]${NC} Memperbarui daftar paket..."
apk update

echo ""
echo -e "${CYAN}[2/3]${NC} Mengupgrade paket yang tersedia..."
apk upgrade

echo ""
echo -e "${CYAN}[3/3]${NC} Membersihkan cache lama..."
apk cache clean

echo ""
echo -e "${GREEN}╔══════════════════════════════════════╗${NC}"
echo -e "${GREEN}║${NC}     ✅  Sistem berhasil diupdate!     ${GREEN}║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════╝${NC}"
echo ""
