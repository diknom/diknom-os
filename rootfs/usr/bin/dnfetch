#!/bin/bash
# ============================================
#   dnfetch - DIKNOM System Info
#   Mirip neofetch tapi ala DIKNOM OS
# ============================================

# Warna
BLUE='\033[0;34m'
CYAN='\033[0;36m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BOLD='\033[1m'
NC='\033[0m'

# Ambil info sistem
OS=$(cat /etc/os-release | grep PRETTY_NAME | cut -d'"' -f2)
KERNEL=$(uname -r)
HOSTNAME=$(hostname)
USER=$(whoami)
UPTIME=$(uptime -p 2>/dev/null || echo "N/A")
CPU=$(grep "model name" /proc/cpuinfo | head -1 | cut -d':' -f2 | sed 's/^ //')
RAM_USED=$(free -h | awk '/Mem/{print $3}')
RAM_TOTAL=$(free -h | awk '/Mem/{print $2}')
DISK_USED=$(df -h / | awk 'NR==2{print $3}')
DISK_TOTAL=$(df -h / | awk 'NR==2{print $2}')
SHELL_NAME=$(basename "$SHELL")
PACKAGES=$(apk list --installed 2>/dev/null | wc -l)
IP_LOCAL=$(hostname -I 2>/dev/null | awk '{print $1}' || echo "N/A")

echo ""
echo -e "${BLUE}  ██████╗ ██╗██╗  ██╗${NC}"
echo -e "${BLUE}  ██╔══██╗██║██║ ██╔╝${NC}   ${BOLD}${USER}@${HOSTNAME}${NC}"
echo -e "${BLUE}  ██║  ██║██║█████╔╝ ${NC}   ${CYAN}────────────────────────${NC}"
echo -e "${BLUE}  ██║  ██║██║██╔═██╗ ${NC}   ${GREEN}OS       ${NC}: $OS"
echo -e "${BLUE}  ██████╔╝██║██║  ██╗${NC}   ${GREEN}Kernel   ${NC}: $KERNEL"
echo -e "${BLUE}  ╚═════╝ ╚═╝╚═╝  ╚═╝${NC}   ${GREEN}Uptime   ${NC}: $UPTIME"
echo -e "                       ${GREEN}CPU      ${NC}: $CPU"
echo -e "                       ${GREEN}RAM      ${NC}: $RAM_USED / $RAM_TOTAL"
echo -e "                       ${GREEN}Disk     ${NC}: $DISK_USED / $DISK_TOTAL"
echo -e "                       ${GREEN}Shell    ${NC}: $SHELL_NAME"
echo -e "                       ${GREEN}Paket    ${NC}: $PACKAGES terinstall"
echo -e "                       ${GREEN}IP Lokal ${NC}: $IP_LOCAL"
echo ""
echo -e "  ${YELLOW}DIKNOM OS 1.0 - Blitar Edition${NC}"
echo -e "  ${CYAN}by Dikki Nomiarki${NC}"
echo ""
