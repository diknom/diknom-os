#!/bin/sh
# help - pusat bantuan DikNom OS

B='\033[1m'; G='\033[0;32m'; C='\033[0;36m'; Y='\033[0;33m'; N='\033[0m'

utama() {
    printf '\n%b\n' "${B}  DikNom OS - Pusat Bantuan${N}"
    printf '%b\n' "  ------------------------------"
    printf '  %bhelp paket%b      kelola paket .dnp\n' "$G" "$N"
    printf '  %bhelp sistem%b     info & perawatan\n' "$G" "$N"
    printf '  %bhelp file%b       kelola file & folder\n' "$G" "$N"
    printf '  %bhelp jaringan%b   cek koneksi\n' "$G" "$N"
    printf '  %bhelp pkg%b      panduan pkg\n\n' "$G" "$N"
    printf '  %bPerintah inti:%b pkg, dnfetch, help\n' "$B" "$N"
    printf '  %bAlias:%b h/?, ll, cls, sysinfo, pkg\n\n' "$B" "$N"
    printf '  %bCatatan:%b ini ISO live v0.1, belum ada GUI.\n' "$Y" "$N"
    printf '  %bCatatan:%b repo paket .dnp aktif mulai v0.4.\n\n' "$Y" "$N"
}

paket() {
    printf '\n%b  PAKET .DNP%b\n\n' "$B" "$N"
    printf '  Pasang file paket : pkg install ./aplikasi-1.0.dnp\n'
    printf '  Daftar terpasang  : pkg list\n'
    printf '  Hapus             : pkg remove aplikasi\n'
    printf '  Cek kesehatan      : pkg doctor\n\n'
    printf '  %bBelum ada repo online.%b pkg v0.1 hanya memasang\n' "$Y" "$N"
    printf '  file .dnp lokal. Repo sendiri mendarat di v0.4.\n\n'
}

sistem() {
    printf '\n%b  SISTEM%b\n\n' "$B" "$N"
    printf '  dnfetch      ringkasan sistem\n'
    printf '  htop         monitor proses\n'
    printf '  free -h      RAM\n'
    printf '  df -h        disk\n'
    printf '  pkg doctor cek dasar\n'
    printf '  cat /etc/diknom-build   info build\n'
    printf '  dnmode       info & atur resolusi layar\n\n'
}

file() {
    printf '\n%b  FILE & FOLDER%b\n\n' "$B" "$N"
    printf '  ls / ll          lihat isi\n'
    printf '  cd / cd .. / cd ~\n'
    printf '  mkdir / cp / mv / rm\n'
    printf '  nano namafile    edit teks\n\n'
}

jaringan() {
    printf '\n%b  JARINGAN%b\n\n' "$B" "$N"
    printf '  ip addr          alamat IP\n'
    printf '  ip route         gateway\n'
    printf '  ping -c3 1.1.1.1\n'
    printf '  udhcpc -i eth0   minta DHCP manual\n\n'
    printf '  %bv0.1 belum ada wifi manager. Kabel dulu.%b\n\n' "$Y" "$N"
}

case "$1" in
    paket|install|app)      paket ;;
    sistem|system|info)     sistem ;;
    file|folder)            file ;;
    jaringan|network|wifi)  jaringan ;;
    pkg|pkg)              pkg help ;;
    *)                      utama ;;
esac
