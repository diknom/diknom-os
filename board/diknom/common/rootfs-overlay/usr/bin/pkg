#!/bin/sh
# ============================================================
#  pkg - DikNom Package Manager v0.2
#  Repo: index.tab di repo DikNom OS (nama, versi, arch, url, sha256, bin)
#  Semua paket adalah biner statis -> jalan di Lite (musl) maupun normal (glibc)
# ============================================================

VERSION=0.2
DB=/var/lib/dnpkg
IDX="$DB/index.tab"
LOG=/var/log/dnpkg.log
REPO_URL="${PKG_REPO_URL:-https://raw.githubusercontent.com/diknom/diknom-os/main/repo/index.tab}"
ARCH=$(uname -m)
TMP="${TMPDIR:-/tmp}/pkg.$$"

CMD="$1"
ARG="$2"

say() { printf '%b\n' "$*"; }
ok()  { printf '\033[0;32m[ok]\033[0m %s\n' "$*"; }
err() { printf '\033[0;31m[!]\033[0m %s\n' "$*"; }
info(){ printf '\033[0;36m[>]\033[0m %s\n' "$*"; }

logact() { mkdir -p /var/log 2>/dev/null; echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG" 2>/dev/null; }
need_root() { [ "$(id -u)" = "0" ] || { err "butuh root. Jalankan: su -"; exit 1; }; }

dl() {  # dl <url> <dest>
    # curl didahulukan: wget di Lite adalah applet BusyBox yang tidak punya TLS,
    # jadi https selalu gagal kalau wget dicoba lebih dulu.
    ERR="/tmp/pkg-dl.err"
    if command -v curl >/dev/null 2>&1; then
        curl -sfL --connect-timeout 20 -o "$2" "$1" 2>"$ERR" && [ -s "$2" ] && return 0
    fi
    if command -v wget >/dev/null 2>&1; then
        wget -q -O "$2" "$1" 2>"$ERR" && [ -s "$2" ] && return 0
    fi
    return 1
}

repo_line() {  # repo_line <nama>  -> cetak baris index untuk arch ini
    [ -f "$IDX" ] || return 1
    awk -F'\t' -v n="$1" -v a="$ARCH" '!/^#/ && $1==n && $3==a {print; exit}' "$IDX"
}

cmd_update() {
    info "Mengunduh index repo: $REPO_URL"
    mkdir -p "$DB"
    TMPIDX="$TMP.index"
    if ! dl "$REPO_URL" "$TMPIDX"; then
        err "Gagal mengunduh index."
        say "  URL    : $REPO_URL"
        say "  curl   : $(command -v curl >/dev/null 2>&1 && echo ada || echo TIDAK ADA)"
        say "  wget   : $(command -v wget >/dev/null 2>&1 && echo ada || echo 'TIDAK ADA')"
        [ -s /tmp/pkg-dl.err ] && say "  pesan  : $(head -2 /tmp/pkg-dl.err)"
        say "  cek jaringan: ping -c1 github.com"
        exit 1
    fi
    if ! head -1 "$TMPIDX" | grep -q "^# name"; then
        err "Index tidak valid (header tidak dikenali). Dibatalkan."
        rm -f "$TMPIDX"
        exit 1
    fi
    mv "$TMPIDX" "$IDX"
    JML=$(awk '!/^#/ && NF>0' "$IDX" | wc -l | tr -d ' ')
    ok "Index diperbarui: $JML entri paket tersedia untuk semua arsitektur"
    logact "UPDATE index ($JML entri)"
}

cmd_search() {
    [ -n "$ARG" ] || { err "Pakai: pkg search <kata>"; exit 1; }
    [ -f "$IDX" ] || { err "Index belum ada. Jalankan: pkg update"; exit 1; }
    say ""
    say "Hasil pencarian '$ARG' untuk arsitektur $ARCH:"
    HIT=0
    while IFS="	" read -r n v a u s b d; do
        case "$n" in \#*|"") continue ;; esac
        [ "$a" = "$ARCH" ] || continue
        case "$n $d" in
            *"$ARG"*) printf '  %-10s %-8s %s\n' "$n" "$v" "$d"; HIT=$((HIT+1)) ;;
        esac
    done < "$IDX"
    [ "$HIT" = "0" ] && say "  (tidak ada yang cocok)"
    say ""
}

cmd_info() {
    [ -n "$ARG" ] || { err "Pakai: pkg info <nama>"; exit 1; }
    LINE=$(repo_line "$ARG") || { err "$ARG tidak ada di repo untuk $ARCH"; exit 1; }
    [ -n "$LINE" ] || { err "$ARG tidak tersedia untuk arsitektur $ARCH"; exit 1; }
    printf '%s\n' "$LINE" | awk -F'\t' '
        { printf "\n  Nama    : %s\n  Versi   : %s\n  Arch    : %s\n  Ket     : %s\n  URL     : %s\n  sha256  : %s\n\n", $1,$2,$3,$7,$4,$5 }'
}

install_bin() {  # install_bin <nama> <versi> <url> <sha> <bin>
    NAMA="$1"; VER="$2"; URL="$3"; SHA="$4"; BIN="$5"
    mkdir -p "$TMP"
    FILE="$TMP/paket"
    info "Mengunduh $NAMA $VER ..."
    if ! dl "$URL" "$FILE"; then err "Unduhan gagal: $URL"; rm -rf "$TMP"; exit 1; fi

    if command -v sha256sum >/dev/null 2>&1; then
        GOT=$(sha256sum "$FILE" | cut -d' ' -f1)
        if [ "$GOT" != "$SHA" ]; then
            err "sha256 tidak cocok — paket ditolak."
            say "  diharapkan: $SHA"
            say "  didapat   : $GOT"
            rm -rf "$TMP"; exit 1
        fi
        ok "sha256 cocok"
    else
        err "sha256sum tidak ada, verifikasi dilewati (tidak aman)"
    fi

    case "$URL" in
        *.tar.gz|*.tgz)
            tar -xzf "$FILE" -C "$TMP" 2>/dev/null || { err "Ekstraksi gagal"; rm -rf "$TMP"; exit 1; }
            SRC=$(find "$TMP" -type f -name "$BIN" | head -1)
            ;;
        *)  SRC="$FILE" ;;
    esac
    [ -n "$SRC" ] && [ -f "$SRC" ] || { err "Biner '$BIN' tidak ditemukan di paket"; rm -rf "$TMP"; exit 1; }

    mkdir -p /usr/bin
    cp "$SRC" "/usr/bin/$BIN" || { err "Gagal menyalin ke /usr/bin"; rm -rf "$TMP"; exit 1; }
    chmod 0755 "/usr/bin/$BIN"

    mkdir -p "$DB/installed/$NAMA"
    echo "/usr/bin/$BIN" > "$DB/installed/$NAMA/files"
    printf 'name=%s\nversion=%s\narch=%s\nsource=%s\nsha256=%s\ninstalled=%s\n' \
        "$NAMA" "$VER" "$ARCH" "$URL" "$SHA" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "$DB/installed/$NAMA/meta"
    rm -rf "$TMP"
    logact "INSTALL $NAMA $VER ($ARCH)"
    ok "$NAMA $VER terpasang di /usr/bin/$BIN"
}

cmd_install() {
    TARGET="$ARG"
    [ -n "$TARGET" ] || { err "Pakai: pkg install <nama>   atau   pkg install ./file.dnp"; exit 1; }
    need_root

    case "$TARGET" in
        *.dnp|*.tar.gz|./*|/*)
            [ -f "$TARGET" ] || { err "File tidak ada: $TARGET"; exit 1; }
            install_local "$TARGET"
            return ;;
    esac

    [ -f "$IDX" ] || { err "Index belum ada. Jalankan dulu: pkg update"; exit 1; }
    LINE=$(repo_line "$TARGET")
    [ -n "$LINE" ] || { err "$TARGET tidak ada di repo untuk arsitektur $ARCH"; say "Coba: pkg search $TARGET"; exit 1; }

    VER=$(printf '%s' "$LINE" | cut -f2)
    URL=$(printf '%s' "$LINE" | cut -f4)
    SHA=$(printf '%s' "$LINE" | cut -f5)
    BIN=$(printf '%s' "$LINE" | cut -f6)
    if [ -d "$DB/installed/$TARGET" ]; then
        OLD=$(sed -n 's/^version=//p' "$DB/installed/$TARGET/meta" 2>/dev/null)
        [ "$OLD" = "$VER" ] && { ok "$TARGET $VER sudah terpasang"; exit 0; }
        info "Memperbarui $TARGET: $OLD -> $VER"
    fi
    install_bin "$TARGET" "$VER" "$URL" "$SHA" "$BIN"
}

install_local() {  # paket .dnp lokal (format lama, tetap didukung)
    FILE="$1"
    NAMA=$(tar -xzOf "$FILE" .dnpinfo 2>/dev/null | sed -n 's/^name=//p' | head -1)
    VER=$(tar -xzOf "$FILE" .dnpinfo 2>/dev/null | sed -n 's/^version=//p' | head -1)
    [ -n "$NAMA" ] || { err "Paket cacat: .dnpinfo tanpa 'name='"; exit 1; }
    info "Memasang $NAMA $VER dari file lokal"
    tar -xzf "$FILE" -C / --exclude=.dnpinfo 2>/dev/null || { err "Ekstraksi gagal"; exit 1; }
    mkdir -p "$DB/installed/$NAMA"
    tar -tzf "$FILE" | grep -v '^\.dnpinfo$' > "$DB/installed/$NAMA/files"
    printf 'name=%s\nversion=%s\ninstalled=%s\nsource=%s\n' "$NAMA" "$VER" \
        "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FILE" > "$DB/installed/$NAMA/meta"
    logact "INSTALL-LOCAL $NAMA $VER"
    ok "$NAMA $VER terpasang"
}

cmd_remove() {
    NAMA="$ARG"
    [ -n "$NAMA" ] || { err "Pakai: pkg remove <nama>"; exit 1; }
    [ -d "$DB/installed/$NAMA" ] || { err "$NAMA tidak terpasang"; exit 1; }
    need_root
    while IFS= read -r f; do
        case "$f" in ""|/*/|../*) continue ;; esac
        rm -f "/${f#/}" 2>/dev/null
    done < "$DB/installed/$NAMA/files"
    rm -rf "$DB/installed/$NAMA"
    logact "REMOVE $NAMA"
    ok "$NAMA dihapus"
}

cmd_upgrade() {
    need_root
    [ -f "$IDX" ] || { err "Index belum ada. Jalankan: pkg update"; exit 1; }
    info "Memeriksa paket terpasang terhadap repo..."
    ADA=0
    for d in "$DB"/installed/*; do
        [ -d "$d" ] || continue
        N=$(basename "$d")
        CUR=$(sed -n 's/^version=//p' "$d/meta" 2>/dev/null)
        LINE=$(repo_line "$N")
        [ -n "$LINE" ] || continue
        NEW=$(printf '%s' "$LINE" | cut -f2)
        if [ "$CUR" != "$NEW" ]; then
            info "$N: $CUR -> $NEW"
            URL=$(printf '%s' "$LINE" | cut -f4); SHA=$(printf '%s' "$LINE" | cut -f5); BIN=$(printf '%s' "$LINE" | cut -f6)
            install_bin "$N" "$NEW" "$URL" "$SHA" "$BIN"
            ADA=$((ADA+1))
        fi
    done
    [ "$ADA" = "0" ] && ok "Semua paket sudah versi terbaru"
    logact "UPGRADE ($ADA paket)"
}

cmd_list() {
    say ""
    say "Paket terpasang:"
    F=0
    for d in "$DB"/installed/*; do
        [ -d "$d" ] || continue
        F=1
        N=$(basename "$d")
        V=$(sed -n 's/^version=//p' "$d/meta" 2>/dev/null)
        A=$(sed -n 's/^arch=//p' "$d/meta" 2>/dev/null)
        printf '  %-10s %-8s %s\n' "$N" "$V" "$A"
    done
    [ "$F" = "1" ] || say "  (belum ada — paket bawaan sistem tidak dikelola pkg)"
    say ""
}

cmd_files() {
    [ -n "$ARG" ] || { err "Pakai: pkg files <nama>"; exit 1; }
    [ -d "$DB/installed/$ARG" ] || { err "$ARG tidak terpasang"; exit 1; }
    cat "$DB/installed/$ARG/files"
}

cmd_doctor() {
    say ""
    say "Pemeriksaan:"
    ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 && ok "jaringan: tersambung" || err "jaringan: tidak ada"
    say "  arsitektur      : $ARCH"
    say "  repo            : $REPO_URL"
    if [ -f "$IDX" ]; then
        say "  index lokal     : $(awk '!/^#/ && NF>0' "$IDX" | wc -l | tr -d ' ') entri"
    else
        say "  index lokal     : belum ada (jalankan pkg update)"
    fi
    say "  paket terpasang : $(ls "$DB/installed" 2>/dev/null | wc -l | tr -d ' ')"
    say "  build           : $(tr '\n' ' ' < /etc/diknom-build 2>/dev/null)"
    say ""
}

cmd_help() {
    say ""
    printf '\033[1m  pkg %s - DikNom Package Manager\033[0m\n\n' "$VERSION"
    say "  pkg update              unduh index repo"
    say "  pkg search <kata>       cari paket di repo"
    say "  pkg info   <nama>       detail paket"
    say "  pkg install <nama>      pasang dari repo"
    say "  pkg install ./file.dnp  pasang dari file lokal"
    say "  pkg upgrade             perbarui paket terpasang"
    say "  pkg remove <nama>       hapus paket"
    say "  pkg list                paket terpasang"
    say "  pkg files  <nama>       berkas milik paket"
    say "  pkg doctor              cek sistem & repo"
    say ""
    say "  Paket di repo adalah biner statis, jadi jalan di Lite (musl)"
    say "  maupun di DikNom OS normal (glibc). Verifikasi sha256 selalu aktif."
    say ""
    say "  apt dan apk tidak ada di DikNom OS: sistem ini dibangun dari source."
    say ""
}

case "$CMD" in
    update)             cmd_update ;;
    search|find)        cmd_search ;;
    info|show)          cmd_info ;;
    install|add)        cmd_install ;;
    remove|del|delete|rm) cmd_remove ;;
    upgrade)            cmd_upgrade ;;
    list|ls)            cmd_list ;;
    files)              cmd_files ;;
    doctor|check)       cmd_doctor ;;
    help|--help|-h|"")  cmd_help ;;
    *)
        err "Perintah '$CMD' tidak dikenal."
        say "Coba: pkg help"
        exit 1 ;;
esac
