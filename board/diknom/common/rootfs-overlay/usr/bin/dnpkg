#!/bin/sh
# ============================================================
#  dnpkg - Diknom Package Manager v0.1
#  Jujur: v0.1 hanya memasang file .dnp lokal.
#  Tidak ada apt, tidak ada apk, tidak ada repo online.
# ============================================================

VERSION=0.1
DB=/var/lib/dnpkg
LOG=/var/log/dnpkg.log
CMD="$1"
ARG="$2"

say() { printf '%b\n' "$*"; }
ok()  { printf '\033[0;32m[ok]\033[0m %s\n' "$*"; }
err() { printf '\033[0;31m[!]\033[0m %s\n' "$*"; }

logact() { echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG" 2>/dev/null; }

need_root() {
    [ "$(id -u)" = "0" ] || { err "butuh root. Jalankan: su - lalu ulangi."; exit 1; }
}

cmd_install() {
    FILE="$ARG"
    [ -n "$FILE" ] || { err "Pakai: dnpkg install ./paket.dnp"; exit 1; }
    [ -f "$FILE" ] || { err "File tidak ada: $FILE"; exit 1; }
    case "$FILE" in
        *.dnp|*.tar.gz|*.tgz) ;;
        *) err "Format tidak dikenal. Pakai .dnp (tar.gz berisi .dnpinfo)"; exit 1 ;;
    esac

    NAME=$(tar -xzOf "$FILE" .dnpinfo 2>/dev/null | sed -n 's/^name=//p' | head -1)
    VER=$(tar -xzOf "$FILE" .dnpinfo 2>/dev/null | sed -n 's/^version=//p' | head -1)
    [ -n "$NAME" ] || { err "Paket cacat: .dnpinfo tanpa 'name='"; exit 1; }

    need_root
    if [ -d "$DB/installed/$NAME" ]; then
        err "$NAME sudah terpasang. Hapus dulu: dnpkg remove $NAME"; exit 1
    fi

    say "Memasang ${NAME} ${VER}..."
    tar -xzf "$FILE" -C / --exclude=.dnpinfo 2>/dev/null || {
        err "Ekstraksi gagal"; exit 1; }

    mkdir -p "$DB/installed/$NAME"
    tar -tzf "$FILE" | grep -v '^\.dnpinfo$' > "$DB/installed/$NAME/files"
    printf 'name=%s\nversion=%s\ninstalled=%s\nsource=%s\n' \
        "$NAME" "$VER" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$FILE" > "$DB/installed/$NAME/meta"

    logact "INSTALL $NAME $VER"
    ok "$NAME $VER terpasang"
}

cmd_remove() {
    NAME="$ARG"
    [ -n "$NAME" ] || { err "Pakai: dnpkg remove <nama>"; exit 1; }
    [ -d "$DB/installed/$NAME" ] || { err "$NAME tidak terpasang"; exit 1; }
    need_root

    say "Menghapus $NAME..."
    while IFS= read -r f; do
        [ -z "$f" ] && continue
        case "$f" in
            */) continue ;;
        esac
        case "$f" in
            /*|../*) continue ;;
        esac
        rm -f "/$f" 2>/dev/null
    done < "$DB/installed/$NAME/files"
    rm -rf "$DB/installed/$NAME"
    logact "REMOVE $NAME"
    ok "$NAME dihapus"
}

cmd_list() {
    say ""
    say "Paket .dnp terpasang:"
    FOUND=0
    for d in "$DB"/installed/*; do
        [ -d "$d" ] || continue
        FOUND=1
        N=$(sed -n 's/^name=//p' "$d/meta" 2>/dev/null)
        V=$(sed -n 's/^version=//p' "$d/meta" 2>/dev/null)
        printf '  %-24s %s\n' "$N" "$V"
    done
    [ "$FOUND" = "1" ] || say "  (belum ada — v0.1 hanya paket bawaan)"
    say ""
    say "Paket bawaan sistem dihitung terpisah dan tidak dikelola dnpkg."
    say ""
}

cmd_info() {
    NAME="$ARG"
    [ -n "$NAME" ] || { err "Pakai: dnpkg info <nama>"; exit 1; }
    [ -d "$DB/installed/$NAME" ] || { err "$NAME tidak terpasang"; exit 1; }
    cat "$DB/installed/$NAME/meta"
    say ""
    say "File:"
    sed 's/^/  /' "$DB/installed/$NAME/files"
}

cmd_history() {
    [ -f "$LOG" ] && tail -30 "$LOG" || say "Belum ada riwayat."
}

cmd_doctor() {
    say ""
    say "Pemeriksaan dasar:"
    ping -c1 -W2 1.1.1.1 >/dev/null 2>&1 \
        && ok "jaringan: tersambung" || err "jaringan: tidak ada"
    ok "root filesystem: $(awk '$2=="/"{print $3}' /proc/mounts)"
    say "  RAM bebas: $(awk '/MemFree/{printf "%.0f MB", $2/1024}' /proc/meminfo)"
    say "  Paket .dnp: $(ls "$DB/installed" 2>/dev/null | wc -l | tr -d ' ') terpasang"
    say "  Build     : $(cat /etc/diknom-build 2>/dev/null | tr '\n' ' ')"
    say ""
}

cmd_help() {
    say ""
    printf '\033[1m  dnpkg %s - Diknom Package Manager\033[0m\n\n' "$VERSION"
    say "  dnpkg install <file.dnp>   pasang paket lokal"
    say "  dnpkg remove  <nama>       hapus paket"
    say "  dnpkg list                 daftar paket .dnp terpasang"
    say "  dnpkg info    <nama>       detail paket"
    say "  dnpkg history              riwayat"
    say "  dnpkg doctor               cek sistem"
    say "  dnpkg help                 bantuan ini"
    say ""
    say "  v0.1 belum punya repo online. Paket bawaan tidak lewat dnpkg."
    say ""
}

case "$CMD" in
    install|add)      cmd_install ;;
    remove|del|rm)    cmd_remove ;;
    list|ls)          cmd_list ;;
    info|show)        cmd_info ;;
    history|log)      cmd_history ;;
    doctor|check)     cmd_doctor ;;
    update|upgrade)
        err "Repo paket Diknom belum aktif di v0.1."
        say "Rencana: index .dnp di GitHub Releases mulai v0.4."
        exit 1 ;;
    help|--help|-h|"") cmd_help ;;
    *)
        err "Perintah '$CMD' tidak dikenal."
        say "Coba: dnpkg help"
        exit 1 ;;
esac
