#!/bin/sh
# dnmode - info dan pengaturan resolusi layar (framebuffer)
# Membaca langsung apa yang disediakan hardware; tidak mengarang nilai.

FB=/sys/class/graphics/fb0
C='\033[0;36m'; G='\033[0;32m'; Y='\033[0;33m'; B='\033[1m'; N='\033[0m'

info() {
    if [ ! -d "$FB" ]; then
        printf '%b\n' "${Y}Tidak ada framebuffer (/sys/class/graphics/fb0).${N}"
        printf 'Konsol berjalan di mode teks. Di mesin UEFI, aktifkan gfxpayload=keep.\n'
        return 1
    fi
    NAME=$(cat "$FB/name" 2>/dev/null || echo "?")
    MODE=$(cat "$FB/modes" 2>/dev/null | head -1)
    VIRT=$(cat "$FB/virtual_size" 2>/dev/null | tr ',' 'x')
    BPP=$(cat "$FB/bits_per_pixel" 2>/dev/null)
    printf '\n%b  LAYAR%b\n' "$B" "$N"
    printf '  Driver     : %s\n' "$NAME"
    printf '  Mode aktif : %s\n' "${MODE:-?}"
    printf '  Virtual    : %s\n' "${VIRT:-?}"
    printf '  Kedalaman  : %s bit\n' "${BPP:-?}"
    printf '\n  Mode yang ditawarkan hardware:\n'
    if [ -s "$FB/modes" ]; then
        sed 's/^/    /' "$FB/modes"
    else
        printf '    (driver tidak mengekspos daftar mode)\n'
    fi
    printf '\n  Ganti mode: dnmode set 1024x768\n\n'
}

need_root() {
    [ "$(id -u)" = "0" ] || { printf '%b\n' "${Y}Butuh root untuk mengubah mode.${N}"; exit 1; }
}

case "$1" in
    list)
        [ -s "$FB/modes" ] && sed 's/^/  /' "$FB/modes" || printf '  (kosong)\n' ;;
    set)
        [ -n "$2" ] || { printf 'Pakai: dnmode set 1024x768\n'; exit 1; }
        need_root
        [ -w "$FB/modes" ] || {
            printf '%b\n' "${Y}Driver tidak mengizinkan ganti mode runtime.${N}"
            printf 'Ubah lewat GRUB: gfxmode=%s\n' "$2"; exit 1; }
        printf '%s\n' "$2" > "$FB/modes" 2>/dev/null || {
            printf '%b\n' "${Y}Mode $2 ditolak hardware.${N} Cek: dnmode list"; exit 1; }
        printf '%b\n' "${G}Mode diubah ke $2${N}"
        info ;;
    ""|info)
        info ;;
    *)
        printf 'Pakai: dnmode [info|list|set <lebar>x<tinggi>]\n' ;;
esac
