#!/bin/sh
# dnfetch - info sistem DikNom OS (semua angka dibaca langsung, tidak dikarang)

. /etc/os-release 2>/dev/null || true
. /etc/diknom-build 2>/dev/null || true

KERNEL=$(uname -r)
ARCH=$(uname -m)
HOST=$(hostname 2>/dev/null || echo unknown)
USER_NAME=$(id -un 2>/dev/null || echo unknown)
UPTIME=$(awk '{printf "%d jam %d menit", $1/3600, ($1%3600)/60}' /proc/uptime 2>/dev/null || echo N/A)
CPU=$(awk -F':' '/model name/{gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
[ -z "$CPU" ] && CPU=$(awk -F':' '/^Processor/{gsub(/^ +/,"",$2); print $2; exit}' /proc/cpuinfo 2>/dev/null)
[ -z "$CPU" ] && CPU="tidak terbaca"
MEMT=$(awk '/MemTotal/{printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null)
MEMF=$(awk '/MemFree/{printf "%.0f", $2/1024}' /proc/meminfo 2>/dev/null)
ROOTFS=$(awk '$2=="/"{print $3}' /proc/mounts 2>/dev/null)
PKGN=$(ls /var/lib/dnpkg/installed 2>/dev/null | wc -l | tr -d ' ')

printf '\n'
printf '   \033[1;34m#####  \033[0m  \033[1m%s@%s\033[0m\n' "$USER_NAME" "$HOST"
printf '   \033[1;34m#   #  \033[0m  \033[0;36m----------------------------\033[0m\n'
printf '   \033[1;34m#    # \033[0m  OS        : %s\n' "${PRETTY_NAME:-DikNom OS}"
printf '   \033[1;34m#   #  \033[0m  Versi     : %s (%s)\n' "${DIKNOM_VERSION:-?}" "${DIKNOM_ARCH:-$ARCH}"
printf '   \033[1;34m#####  \033[0m  Kernel    : %s\n' "$KERNEL"
printf '              Arsitektur: %s\n' "$ARCH"
printf '              CPU       : %s\n' "$CPU"
printf '              RAM       : %s MB terpakai bebas / %s MB total\n' "$MEMF" "$MEMT"
printf '              Root      : %s\n' "${ROOTFS:-?}"
printf '              Uptime    : %s\n' "$UPTIME"
printf '              Paket .dnp: %s terpasang\n' "$PKGN"
printf '              Dibangun  : %s\n' "${DIKNOM_BUILD_DATE:-build lokal}"
printf '\n   \033[0;33mDikNom OS - dibangun dari source\033[0m\n'
printf '   \033[0;36mby Dikki Nomiarki\033[0m\n\n'
