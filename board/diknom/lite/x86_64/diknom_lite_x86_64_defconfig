# ============================================================
#  DikNom OS - konfigurasi build 64-bit
# ============================================================
BR2_x86_64=y
# Baseline x86-64 (SSE2 saja): jalan di SEMUA CPU x86-64, termasuk
# CPU tua dan CPU emulasi QEMU. corei7/skylake memakai SSE4.2 yang
# membuat init mati SIGILL di hardware lama.
BR2_x86_x86_64=y
BR2_LINUX_KERNEL_DEFCONFIG="x86_64"
BR2_TOOLCHAIN_BUILDROOT_MUSL=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
BR2_KERNEL_HEADERS_AS_KERNEL=y

BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

BR2_TARGET_GENERIC_HOSTNAME="diknom-lite"
BR2_TARGET_GENERIC_ISSUE="DikNom OS Lite 0.1 (Blitar Edition)"
BR2_TARGET_GENERIC_ROOT_PASSWD="diknom"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_TARGET_GENERIC_GETTY_PORT="tty1"

BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.30"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/diknom/common/kernel-live.fragment"
BR2_LINUX_KERNEL_INSTALL_TARGET=y

BR2_TARGET_ROOTFS_CPIO=y
BR2_TARGET_ROOTFS_CPIO_GZIP=y

BR2_ROOTFS_OVERLAY="board/diknom/common/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="board/diknom/common/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="board/diknom/common/post-image.sh"

BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_NANO=y
BR2_PACKAGE_HTOP=y
BR2_PACKAGE_LESS=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_UTIL_LINUX=y
BR2_PACKAGE_UTIL_LINUX_BINARIES=y
BR2_PACKAGE_PROCPS_NG=y
BR2_PACKAGE_FILE=y
BR2_PACKAGE_TAR=y
BR2_PACKAGE_GZIP=y

# --- percepat rebuild: ccache dibagi lewat cache Actions ---
BR2_CCACHE=y
BR2_CCACHE_DIR="$(HOME)/.buildroot-ccache"
BR2_CCACHE_INITIAL_SETUP="--max-size=5G"
BR2_CCACHE_USE_BASEDIR=y

# ============================================================
#  v0.2 - lapisan grafis X11
# ============================================================
BR2_PACKAGE_XORG7=y
BR2_PACKAGE_XSERVER_XORG_SERVER=y
BR2_PACKAGE_XSERVER_XORG_SERVER_MODULAR=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_LIBINPUT=y
BR2_PACKAGE_XDRIVER_XF86_INPUT_EVDEV=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_VESA=y
BR2_PACKAGE_XDRIVER_XF86_VIDEO_FBDEV=y
BR2_PACKAGE_XAPP_XINIT=y
BR2_PACKAGE_XAPP_XAUTH=y
BR2_PACKAGE_XAPP_XSETROOT=y
BR2_PACKAGE_XAPP_XRDB=y
BR2_PACKAGE_XFONT_FONT_MISC_MISC=y
BR2_PACKAGE_XFONT_FONT_CURSOR_MISC=y
BR2_PACKAGE_XTERM=y
BR2_PACKAGE_LIBINPUT=y
# input lewat udev (libinput butuh udev; mdev tidak cukup untuk desktop)
BR2_PACKAGE_EUDEV=y
BR2_PACKAGE_XAPP_TWM=y

# --- kebutuhan pkg: unduh HTTPS dengan verifikasi sertifikat ---
BR2_PACKAGE_OPENSSL=y
BR2_PACKAGE_LIBCURL=y
BR2_PACKAGE_LIBCURL_CURL=y
BR2_PACKAGE_CA_CERTIFICATES=y
