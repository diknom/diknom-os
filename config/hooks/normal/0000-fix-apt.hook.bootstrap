#!/bin/sh
# DikNom OS - hook tahap bootstrap.
#
# live-build versi Ubuntu menulis baris keamanan dengan skema lama:
#   deb http://security.debian.org/ <distro>/updates main
# Debian modern memakai:
#   deb http://security.debian.org/debian-security <distro>-security main
# Karena repo lama tidak ada, apt update gagal dan seluruh build berhenti.
# Sumber yang benar sudah disediakan config/archives/, jadi baris lama dibuang
# di sini — sebelum apt dijalankan pada tahap chroot.
set -e

for f in /etc/apt/sources.list /etc/apt/sources.list.d/*.list; do
    [ -f "$f" ] || continue
    sed -i '/security\.debian\.org.*\/updates/d' "$f"
    # bentuk lain tanpa garis miring
    sed -i '/security\.debian\.org .*-security/d' "$f" 2>/dev/null || true
done

# tampilkan hasilnya di log supaya bisa diperiksa
echo "--- sources.list setelah perbaikan ---"
cat /etc/apt/sources.list 2>/dev/null || true
