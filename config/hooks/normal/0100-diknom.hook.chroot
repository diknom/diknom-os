#!/bin/bash
# DikNom OS - hook chroot: user, autologin, identitas versi.
# Desktop dideteksi dari biner yang benar-benar terpasang, bukan dari nama rasa,
# supaya autologin tidak pernah menunjuk sesi yang tidak ada.
set -e

VER="${DIKNOM_VERSION:-0.3}"

# --- user diknom ---
if ! id diknom >/dev/null 2>&1; then
    useradd -m -s /bin/bash -G sudo,audio,video,netdev,plugdev,cdrom diknom
fi
echo "diknom:diknom" | chpasswd
echo "root:root1234" | chpasswd
mkdir -p /etc/sudoers.d
echo "diknom ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/diknom
chmod 0440 /etc/sudoers.d/diknom

# --- deteksi desktop & display manager ---
if   [ -x /usr/bin/startplasma-x11 ]; then DESKTOP=kde;   SESSION=plasmax11
elif [ -x /usr/bin/gnome-shell ];     then DESKTOP=gnome; SESSION=gnome
elif [ -x /usr/bin/startxfce4 ];      then DESKTOP=xfce;  SESSION=xfce
elif [ -x /usr/bin/startlxqt ];       then DESKTOP=lxqt;  SESSION=lxqt
elif [ -x /usr/bin/mate-session ];    then DESKTOP=mate;  SESSION=mate
elif [ -x /usr/bin/startlxde ];       then DESKTOP=lxde;  SESSION=LXDE
else DESKTOP=lain; SESSION=; fi

if   [ -x /usr/sbin/gdm3 ] || [ -x /usr/sbin/gdm ]; then DM=gdm
elif [ -x /usr/sbin/sddm ] || [ -x /usr/bin/sddm ]; then DM=sddm
elif [ -x /usr/sbin/lightdm ]; then DM=lightdm
else DM=none; fi

# --- autologin sesuai DM ---
case "$DM" in
  gdm)
    mkdir -p /etc/gdm3
    cat > /etc/gdm3/daemon.conf <<EOF
[daemon]
AutomaticLoginEnable=true
AutomaticLogin=root
WaylandEnable=false
TimedLoginEnable=false
EOF
    ;;
  sddm)
    mkdir -p /etc/sddm.conf.d
    cat > /etc/sddm.conf.d/99-diknom.conf <<EOF
[Autologin]
User=root
Session=${SESSION}.desktop
Relogin=false
EOF
    ;;
  lightdm)
    mkdir -p /etc/lightdm/lightdm.conf.d
    cat > /etc/lightdm/lightdm.conf.d/99-diknom.conf <<EOF
[Seat:*]
autologin-user=root
autologin-user-timeout=0
autologin-session=${SESSION}
greeter-hide-users=false
EOF
    ;;
  *)
    echo "PERINGATAN: tidak ada display manager terpasang" ;;
esac

# GDM menolak login root lewat aturan PAM. Hapus baris penolaknya supaya
# autologin root benar-benar masuk (ISO live, bukan sistem produksi).
for pam in /etc/pam.d/gdm-autologin /etc/pam.d/gdm-password; do
    [ -f "$pam" ] && sed -i '/pam_succeed_if.so user != root/d' "$pam" || true
done

# --- metadata ---
echo "$DESKTOP" > /etc/diknom-desktop
echo "$DM" > /etc/diknom-dm
# kernel yang benar-benar terpasang di image ini
KP=""
KKEYS=$(dpkg-query -W -f='${Package} ${Version}\n' 'linux-image-*' 2>/dev/null \
    | grep -vE 'unsigned|dbg|headers|modules' | head -1)
[ -n "$KKEYS" ] && KP="${KKEYS%%\n*}"

cat > /etc/diknom-build <<EOF
DIKNOM_VERSION=$VER
DIKNOM_KERNEL=$KP
DIKNOM_BASE=debian-$(grep VERSION_CODENAME /etc/os-release | cut -d= -f2 | tr -d '"')
DIKNOM_DESKTOP=$DESKTOP
DIKNOM_DM=$DM
DIKNOM_ARCH=$(dpkg --print-architecture)
DIKNOM_BUILD_DATE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
DIKNOM_BUILT_BY=github-actions
EOF

for f in /etc/os-release /etc/issue /etc/motd /usr/local/bin/diknom-about; do
    [ -f "$f" ] && sed -i "s/@VERSION@/${VER}/g" "$f"
done

# --- wallpaper ---
if [ -f /usr/share/backgrounds/diknom-os.png ]; then
    if [ -d /etc/xdg/xfce4/xfconf/xfce-perchannel-xml ]; then
        cat > /etc/xdg/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml <<'XFCE'
<?xml version="1.0" encoding="UTF-8"?>
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/diknom-os.png"/>
          <property name="image-style" type="int" value="5"/>
        </property>
      </property>
    </property>
  </property>
</channel>
XFCE
    fi
    mkdir -p /etc/dconf/db/local.d /etc/dconf/profile
    printf 'user-db:user\nsystem-db:local\n' > /etc/dconf/profile/user
    cat > /etc/dconf/db/local.d/00-diknom <<'DCONF'
[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/diknom-os.png'
picture-uri-dark='file:///usr/share/backgrounds/diknom-os.png'
picture-options='scaled'
primary-color='#1b2430'
DCONF
    command -v dconf >/dev/null 2>&1 && dconf update || true
fi

chmod 0755 /usr/local/bin/pkg /usr/local/bin/dnfetch /usr/local/bin/help /usr/local/bin/diknom-about 2>/dev/null || true

echo "hook DikNom OS selesai (desktop=$DESKTOP dm=$DM versi=$VER)"
