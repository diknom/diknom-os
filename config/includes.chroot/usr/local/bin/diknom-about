#!/bin/sh
# Tentang DikNom OS
# Menyebut pengembang (DikNom) dan menyatakan terus terang bahwa fondasinya
# Debian: kernel dan desktop bukan karya sendiri, penyusunan dan identitas iya.
. /etc/os-release 2>/dev/null || true
BASIS=$(sed -n 's/^DIKNOM_BASE=//p' /etc/diknom-build 2>/dev/null)
DESKTOP=$(cat /etc/diknom-desktop 2>/dev/null || echo "-")
KPKG=$(sed -n 's/^DIKNOM_KERNEL=//p' /etc/diknom-build 2>/dev/null)

TEKS="<big><b>DikNom OS @VERSION@</b></big>

<b>Dikembangkan mandiri oleh DikNom.</b>

Disusun di atas fondasi Debian (${BASIS:-debian}).
Kernel, desktop, dan paket sistem adalah perangkat lunak
yang sudah ada; DikNom OS memilih, mengonfigurasi, dan
memberi identitas.

Desktop : ${DESKTOP}
Kernel  : $(uname -r)
Paket   : ${KPKG:--}
Basis   : ${PRETTY_NAME:-Debian}
Layar   : ${DISPLAY:-konsol}

github.com/diknom/diknom-os"

if command -v zenity >/dev/null 2>&1; then
    exec zenity --info --title="Tentang DikNom OS" --width=480 --height=340 --text="$TEKS"
elif command -v xmessage >/dev/null 2>&1; then
    exec xmessage -center "$TEKS"
else
    printf '%s\n' "$TEKS"
fi
