#!/bin/sh
# DikNom OS - konfigurasi live-build
# Desktop dipilih lewat DIKNOM_DESKTOP, basis lewat DIKNOM_DISTRO.
set -e

DESKTOP="${DIKNOM_DESKTOP:-gnome}"
ARCH="${DIKNOM_ARCH:-amd64}"

# trixie (Debian 13) = kernel 6.12 + desktop terbaru, hanya amd64.
# i386 tetap bookworm (6.1) karena Debian 13 tidak menerbitkan i386 lagi.
case "$ARCH" in
    i386)  DISTRO="${DIKNOM_DISTRO:-bookworm}" ;;
    *)     DISTRO="${DIKNOM_DISTRO:-trixie}" ;;
esac

# Pilih rasa desktop: live-build memakai SEMUA *.list.chroot, jadi sisihkan
# yang tidak dipakai.
mkdir -p config/package-lists.off
for f in config/package-lists/*.list.chroot; do
    [ -e "$f" ] || continue
    [ "$(basename "$f")" = "diknom-${DESKTOP}.list.chroot" ] && continue
    mv "$f" config/package-lists.off/
done
echo "desktop=$DESKTOP arch=$ARCH distro=$DISTRO"
echo "daftar paket aktif: $(ls config/package-lists/*.list.chroot | xargs -n1 basename)"

# Sumber apt sendiri. live-build versi Ubuntu menulis baris keamanan lama
# ("$DISTRO/updates") yang tidak ada lagi di Debian, dan itu menggagalkan
# apt update. Jadi keamanan dimatikan di lb config dan ditulis manual di sini
# dengan skema yang benar ("debian-security $DISTRO-security").
mkdir -p config/archives
cat > config/archives/00-diknom.list.chroot <<EOF
deb http://deb.debian.org/debian $DISTRO main contrib non-free non-free-firmware
deb http://deb.debian.org/debian ${DISTRO}-updates main contrib non-free non-free-firmware
deb http://security.debian.org/debian-security ${DISTRO}-security main contrib non-free non-free-firmware
EOF
echo "sumber apt:"
cat config/archives/00-diknom.list.chroot

case "$ARCH" in
    i386) LF="--linux-flavours 686-pae" ;;
    *)    LF="" ;;
esac

# Mirror eksplisit: default live-build masih ftp.debian.org, yang sudah
# dipensiunkan Debian, sehingga pencarian paket kernel (Contents-*.gz)
# berakhir 404 dan build berhenti di lb_chroot_linux-image.
MIRROR="http://deb.debian.org/debian"
MIRROR_SEC="http://security.debian.org/debian-security"

lb config noauto \
    --mode debian \
    --mirror-bootstrap "$MIRROR" \
    --mirror-chroot "$MIRROR" \
    --mirror-chroot-security "$MIRROR_SEC" \
    --mirror-binary "$MIRROR" \
    --mirror-binary-security "$MIRROR_SEC" \
    --architectures "$ARCH" \
    --distribution "$DISTRO" \
    --archive-areas "main contrib non-free non-free-firmware" \
    --binary-images iso-hybrid \
    --apt-recommends \
    --security false \
    --debian-installer none \
    --memtest none \
    --iso-application "DikNom OS" \
    --iso-publisher "DikNom" \
    --iso-volume "DIKNOM_OS" \
    $LF \
    --bootappend-live "boot=live components quiet splash console=tty0 console=ttyS0,115200" \
    "${@}"
