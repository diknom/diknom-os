# Salin jadi .env untuk build lokal. JANGAN commit .env.
# Tidak ada nilai rahasia di file ini — hanya nama variabel.

# Versi rilis (dipakai post-image.sh kalau tidak di-set)
DIKNOM_VERSION=0.1

# Arsitektur target saat build manual: x86_64 atau i686
DIKNOM_ARCH=x86_64

# URL index repo paket .dnp (aktif mulai v0.4, kosongkan sekarang)
PKG_REPO_URL=

# Jumlah RAM untuk smoke test QEMU di lokal (MB)
DIKNOM_QEMU_RAM=256
